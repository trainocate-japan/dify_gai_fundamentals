#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

script_path="scripts/pdf_package/pre_push_pdf_bundle.ps1"
zero_sha="0000000000000000000000000000000000000000"
empty_tree_sha="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

# Run only when pushed commits include changes under docs/ (excluding docs/assets/).
should_run=0
has_stdin=0
while read -r local_ref local_sha remote_ref remote_sha; do
  has_stdin=1

  # Deleting a ref: nothing to build.
  if [[ "$local_sha" == "$zero_sha" ]]; then
    continue
  fi

  from_sha="$remote_sha"
  if [[ "$remote_sha" == "$zero_sha" ]]; then
    # New remote ref: compare from empty tree.
    from_sha="$empty_tree_sha"
  fi

  if git diff --name-only "$from_sha" "$local_sha" \
      | grep -E '^docs/' \
      | grep -Ev '^docs/assets/' \
      >/dev/null; then
    should_run=1
    break
  fi
done

if [[ "$has_stdin" -eq 1 && "$should_run" -eq 0 ]]; then
  echo "[pdf-bundle] no docs changes detected in push range -> skip"
  exit 0
fi

if command -v pwsh >/dev/null 2>&1; then
  pwsh -NoProfile -ExecutionPolicy Bypass -File "$script_path"
elif command -v powershell.exe >/dev/null 2>&1; then
  powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$script_path"
elif command -v powershell >/dev/null 2>&1; then
  powershell -NoProfile -ExecutionPolicy Bypass -File "$script_path"
else
  echo "[pdf-bundle] PowerShell runtime not found. Cannot run local PDF build hook." >&2
  exit 1
fi
